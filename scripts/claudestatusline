#!/usr/bin/env bash
# claudestatusline — renderer for the Claude Code status line.
#
# Claude Code runs this on every status-line repaint, passing session JSON on
# stdin. It renders in its own row ABOVE Claude Code's built-in footer badges
# (which already show the PR number/url). Rendered on two lines:
#   line 1 = machine · model (red unless Opus) · session · ticket (+ full title
#            from a local cache; the terminal truncates this line at window width)
#   line 2 = git branch (🌲 in a worktree, 🌿 otherwise) · PR url
#
# The stdin JSON does NOT include the git branch, but it does include
# workspace.current_dir, so we cd there and ask git ourselves. When this session
# is bound to a git worktree (recorded per-session by sb-work-on-ticket in
# $cache_dir/worktree_<session>), we cd to that worktree instead — because
# workspace.current_dir keeps pointing at the MAIN tree, which is usually on a
# different branch. The session id comes from stdin (.session_id).
#
# Wire it up in ~/.claude/settings.json:
#   "statusLine": { "type": "command", "command": "~/CLI/scripts/claudestatusline" }

input=$(cat)

# Session id (from stdin) — read early because it keys the per-session worktree marker.
session=$(printf '%s' "$input" | jq -r '.session_id // empty')

# Local cache dir for the network-y / externally-populated bits (PR url, ticket
# title) and the per-session worktree marker.
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/claudestatusline"
mkdir -p "$cache_dir" 2>/dev/null

# Directory we ask git about. Default to the session's workspace dir from stdin.
# But if this session is bound to a git worktree (sb-work-on-ticket records the
# worktree path in $cache_dir/worktree_<session> when it works in multi-instance
# mode), workspace.current_dir still points at the MAIN tree — a different branch
# — so the worktree is the real source of truth. Prefer it while it still points
# at a live directory; drop the marker once the worktree is gone.
dir=$(printf '%s' "$input" | jq -r '.workspace.current_dir // .cwd // empty')
in_worktree=0
if [ -n "$session" ]; then
    wt_marker="$cache_dir/worktree_${session}"
    if [ -f "$wt_marker" ]; then
        wt_dir=$(cat "$wt_marker" 2>/dev/null)
        if [ -n "$wt_dir" ] && [ -d "$wt_dir" ]; then
            dir="$wt_dir"
            in_worktree=1
        else
            rm -f "$wt_marker" 2>/dev/null
        fi
    fi
fi
[ -n "$dir" ] && cd "$dir" 2>/dev/null

branch=$(git branch --show-current 2>/dev/null)

# Machine name via whereami (raw VM/host name); fall back to hostname -s.
machine=$(~/CLI/scripts/whereami --raw 2>/dev/null || hostname -s 2>/dev/null)

# JIRA ticket key parsed from the branch name, if present
# (e.g. smccoy/RECSYSTEM-2143-do-thing → RECSYSTEM-2143). Uppercased for display.
ticket=$(printf '%s' "$branch" | grep -oiE '[A-Z]{2,}-[0-9]+' | head -n1 | tr '[:lower:]' '[:upper:]')

# Full URL of the PR for the current branch (best-effort). `gh pr view` is a
# network call and the status line repaints up to ~3x/sec, so cache the result
# per-branch with a 60s TTL and only shell out when the cache is missing/stale.
# An empty result (no PR) is cached too, so we don't re-hit gh every repaint.
pr_url=""
if [ -n "$branch" ]; then
    safe=$(printf '%s' "$branch" | tr -c 'A-Za-z0-9._-' '_')
    cache_file="$cache_dir/pr_${safe}"
    ttl=60
    now=$(date +%s)
    mtime=$([ -f "$cache_file" ] && stat -c %Y "$cache_file" 2>/dev/null || echo 0)
    if [ $((now - mtime)) -lt "$ttl" ]; then
        pr_url=$(cat "$cache_file" 2>/dev/null)
    else
        pr_url=$(timeout 2 gh pr view --json url --jq '.url' 2>/dev/null)
        printf '%s' "$pr_url" >"$cache_file" 2>/dev/null
    fi
fi

# Model comes straight from the stdin JSON (session id was read earlier).
model=$(printf '%s' "$input" | jq -r '.model.display_name // .model.id // empty')

# Model in red unless it's an Opus model.
model_disp="${model:-(none)}"
if ! printf '%s' "$model" | grep -qi 'opus'; then
    model_disp=$'\033[31m'"$model_disp"$'\033[0m'
fi

# Ticket, with its full JIRA title appended when available. It sits on line 1,
# which the terminal truncates at window width, so the title isn't pre-truncated.
# There is no JIRA CLI/token on this host, so the title is read from a local cache
# ($cache_dir/jira_<TICKET>) populated out-of-band (e.g. by Claude via the JIRA MCP).
ticket_disp="${ticket:-(none)}"
if [ -n "$ticket" ]; then
    title=$(cat "$cache_dir/jira_${ticket}" 2>/dev/null)
    [ -n "$title" ] && ticket_disp="$ticket $title"
fi

# Render on two lines (the single line overflows / gets truncated rather than
# soft-wrapping). Line 1 = identity, line 2 = work context. Every field is always
# shown; an empty one renders as "(none)". Parts are joined by " · ".
line1=(
    "💻 ${machine:-(none)}"
    "🤖 $model_disp"
    "🆔 ${session:-(none)}"
    "🎫 $ticket_disp"
)
# 🌲 (pine) when the branch comes from a git worktree, 🌿 (sprig) otherwise.
branch_icon="🌿"
[ "$in_worktree" = 1 ] && branch_icon="🌲"
line2=(
    "$branch_icon ${branch:-(none)}"
    "🔗 ${pr_url:-(none)}"
)

join_parts() {
    local out="" p
    for p in "$@"; do
        [ -z "$out" ] && out="$p" || out="$out · $p"
    done
    printf '%s' "$out"
}

printf '%s\n%s' "$(join_parts "${line1[@]}")" "$(join_parts "${line2[@]}")"
