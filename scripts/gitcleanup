#!/usr/bin/env swift

import Foundation


// MARK: Utility Funcs
@discardableResult
func shell(_ command: String) throws -> String {
    let task = Process()
    let pipe = Pipe()
    
    task.standardOutput = pipe
    task.standardError = pipe
    task.arguments = ["-c", command]
    task.executableURL = URL(fileURLWithPath: "/bin/zsh") //<--updated
    task.standardInput = nil

    try task.run() //<--updated
    
    let data = pipe.fileHandleForReading.readDataToEndOfFile()
    let output = String(data: data, encoding: .utf8)!
    
    return output
}

func stringPrompt(_ message: String) -> String {
	print(message + ": ", terminator: "") // The terminator "" keeps the cursor on the same line as the prompt
	return readLine() ?? ""
}

func boolPrompt(_ message: String) -> Bool {
	let response = stringPrompt(message)

	return ["y", "Y"].contains(response)
}

func switchBackTo(branch: String) throws {
	if branch != "main" {
		print("Switching back to \(branch)")
		try shell("git checkout \(branch)")
	}
}

// MARK: Script
do {

	// Determine current branch:
	let currentBranch = try shell("git branch").split(separator:"\n").filter {
		$0.contains("*")
	}.map {
		// Remove the "* " prefix on the current branch
		String($0.dropFirst(2))
	}.first

	guard let currentBranch else {
		print("Could not determine current branch!")
		exit(1)
	}

	// Switch to main if neccessary
	if currentBranch != "main" {
		print("currentBranch: \(currentBranch), switching to main")
		try shell("git checkout main")
	}

	print("Fetching remote branch list...")
	let remoteOutput = try shell("git ls-remote --heads origin")
	let remoteBranches = Set(
		remoteOutput
			.split(whereSeparator: \.isNewline)
			.compactMap { line -> String? in
				let parts = String(line).components(separatedBy: "\t")
				guard parts.count == 2 else { return nil }
				let ref = parts[1]
				guard ref.hasPrefix("refs/heads/") else { return nil }
				return String(ref.dropFirst("refs/heads/".count))
			}
	)

	let green = "\u{001B}[32m"
	let reset = "\u{001B}[0m"

	let allLocalBranches = try shell("git branch")
		.split(whereSeparator: \.isNewline)
		.map { line -> String in
			let s = String(line).trimmingCharacters(in: .whitespaces)
			return (s.hasPrefix("* ") || s.hasPrefix("+ ")) ? String(s.dropFirst(2)) : s
		}
		.filter { !$0.isEmpty && $0 != "main" }

	let candidates = allLocalBranches.filter { !remoteBranches.contains($0) }

	for branch in allLocalBranches {
		if remoteBranches.contains(branch) {
			print("\(green)Skipping \(branch) (has remote branch)\(reset)")
		}
	}

	guard candidates.count > 0 else {
		print("No branches to clean up")

		try switchBackTo(branch: currentBranch)

		try shell("command -v say &> /dev/null && say done")
		exit(0)
	}

	// Build a map of branch -> worktree path from `git worktree list --porcelain`
	var worktreePaths: [String: String] = [:]
	let worktreeOutput = try shell("git worktree list --porcelain")
	for group in worktreeOutput.components(separatedBy: "\n\n") {
		var path = ""
		var branch = ""
		for line in group.split(whereSeparator: \.isNewline) {
			let lineStr = String(line)
			if lineStr.hasPrefix("worktree ") {
				path = String(lineStr.dropFirst("worktree ".count))
			} else if lineStr.hasPrefix("branch refs/heads/") {
				branch = String(lineStr.dropFirst("branch refs/heads/".count))
			}
		}
		if !path.isEmpty && !branch.isEmpty {
			worktreePaths[branch] = path
		}
	}

	for branch in candidates {
		if boolPrompt("\(green)Delete branch: \(branch)?\(reset) ") {
			if let worktreePath = worktreePaths[branch] {
				print("Removing worktree at \(worktreePath)...")
				try shell("git worktree remove --force \(worktreePath.replacingOccurrences(of: " ", with: "\\ "))")
			}
			print("Deleting...")
			try shell("git branch -D \(branch)")
		}
	}

	try switchBackTo(branch: currentBranch)

	print("\nRemaining branches:")
	print(try shell("git branch"))

	print("Done!")
	try shell("command -v say &> /dev/null && say done")


} catch {
	print("Error: \(error)")
	exit(1)
}
