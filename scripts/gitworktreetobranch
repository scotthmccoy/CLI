#!/bin/zsh

function color {
    if tty -s
    then
        tput setaf $2
        echo "$1"
        tput sgr0
        return
    fi

    echo "$1"
}

function red {
    color "$1" 1
}

function yellow {
    color "$1" 3
}

function green {
    color "$1" 2
}

function safe_say {
    if command -v say &> /dev/null; then
        say "$1"
    fi
}

function usage {
    cat <<'USAGE'
Usage: gitworktreetobranch [<branch>]

Collapse a linked worktree back into a plain branch checkout.

Removes the worktree for <branch> and checks <branch> out in the main
checkout. With no argument, must be run from inside the linked worktree (it
infers the branch and main checkout). With <branch>, can be run from the main
checkout — the worktree's location is looked up via `git worktree list`, so it
does not need to follow any particular path convention. Fails if the worktree
has uncommitted changes.

Options:
  -h, --help    Show this help and exit
USAGE
}

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
    exit 0
fi

if [ -n "$1" ]; then
    currentBranch="$1"
    mainPath=$(git rev-parse --show-toplevel 2>/dev/null)

    if [ -z "$mainPath" ]; then
        red "Not inside a git repository"
        exit 1
    fi

    worktreePath=$(git worktree list --porcelain | awk -v branch="refs/heads/$currentBranch" '
        /^worktree / { path=$2 }
        /^branch / { if ($2 == branch) print path }
    ')

    if [ -z "$worktreePath" ]; then
        red "No worktree found for branch $currentBranch"
        exit 1
    fi

    if [ -n "$(git -C "$worktreePath" status --porcelain 2>/dev/null)" ]; then
        red "Uncommitted changes in worktree — commit or stash them first"
        exit 1
    fi
else
    # Must be in a linked worktree
    gd=$(git rev-parse --git-dir 2>/dev/null)
    gc=$(git rev-parse --git-common-dir 2>/dev/null)

    if [ -z "$gd" ] || [ "$gd" = "$gc" ]; then
        red "Not in a worktree"
        exit 1
    fi

    # Bail on uncommitted changes
    if [ -n "$(git status --porcelain)" ]; then
        red "Uncommitted changes in worktree — commit or stash them first"
        exit 1
    fi

    currentBranch=$(git rev-parse --abbrev-ref HEAD)
    worktreePath=$(git rev-parse --show-toplevel)
    mainPath=$(dirname "$(git rev-parse --git-common-dir)")
fi

green "Branch: $currentBranch"
green "Worktree: $worktreePath"
green "Main: $mainPath"

cd "$mainPath"

green "Removing worktree $worktreePath..."
git worktree remove "$worktreePath"

if ! [ $? -eq 0 ]; then
    red "Failed to remove worktree"
    exit 1
fi

green "Checking out $currentBranch..."
git checkout "$currentBranch"

if ! [ $? -eq 0 ]; then
    red "Failed to checkout $currentBranch"
    exit 1
fi

green "Done"
